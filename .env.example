# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never commit credentials.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Any Postgres works — pick one:
#
#   Neon (no install):   https://neon.tech -> new project -> copy the string
#   Local install:       winget install PostgreSQL.PostgreSQL.17
#   Docker:              docker run -d --name sms-db -p 5432:5432 \
#                          -e POSTGRES_PASSWORD=sms -e POSTGRES_DB=sms postgres:17
#
# Note on `uselibpqcompat=true`: node-postgres v8.16+ changed what `sslmode`
# means and warns loudly without it. Add it alongside sslmode for any hosted
# Postgres that requires TLS. A plain local Postgres needs neither.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sms?uselibpqcompat=true&sslmode=require"

# Optional, and only needed for serverless Postgres that pools with PgBouncer
# (Neon, Supabase). Point this at the *unpooled* endpoint — for Neon that is
# the same host with "-pooler" removed. Prisma Migrate needs a direct
# connection because PgBouncer does not support the advisory locks and session
# state the migration engine relies on. The running app keeps using the pooled
# DATABASE_URL above. Leave unset for a plain local Postgres.
DIRECT_URL=""

# Secret used to sign session JWTs (HS256). Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-32-byte-random-hex-string"

# Uploaded coursework is written to ./uploads (gitignored, and deliberately
# outside public/ so downloads go through an authorisation check). The path is
# a literal in src/lib/storage.ts rather than an env var — a dynamic path here
# makes Turbopack trace the whole project into the build output.
