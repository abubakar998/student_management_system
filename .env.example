# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never commit credentials.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Any Postgres works — pick one:
#
#   Neon (no install):   https://neon.tech -> new project -> copy the string
#   Local install:       winget install PostgreSQL.PostgreSQL.17
#   Docker:              docker run -d --name sms-db -p 5432:5432 \
#                          -e POSTGRES_PASSWORD=sms -e POSTGRES_DB=sms postgres:17
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sms?sslmode=require"

# Secret used to sign session JWTs (HS256). Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-me-with-a-32-byte-random-hex-string"

# Where uploaded assessment files are written. Relative to the project root.
# This directory is gitignored — uploads are user content, not source.
UPLOAD_DIR="uploads"
